# Copy this file to .env in the project root and adjust as needed.
# python-dotenv (used by backend/run.py) will find this file automatically
# even though Flask is launched from inside backend/.

FLASK_ENV=development
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# SQLite database file, relative to the project root
DATABASE_URL=sqlite:///data/app.db

# Change this in any real deployment
JWT_SECRET_KEY=change-me
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# MinIO connection (host:port, no scheme)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=photos
MINIO_SECURE=false

# Upload limits
MAX_CONTENT_LENGTH_MB=200

# Where persistent app data (sqlite db, minio data dir) lives, relative
# to the project root.
DATA_DIR=data
